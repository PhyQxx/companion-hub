{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ExecutionOutcome": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "execution_status": {
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "unknown_outcome"
          ],
          "title": "Execution Status",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "retry_class": {
          "enum": [
            "safe_read",
            "manual_reconcile",
            "never"
          ],
          "title": "Retry Class",
          "type": "string"
        },
        "side_effect_state": {
          "enum": [
            "none",
            "not_started",
            "submitted",
            "confirmed",
            "unknown"
          ],
          "title": "Side Effect State",
          "type": "string"
        },
        "validation_level": {
          "$ref": "#/$defs/ValidationLevel",
          "default": "V0"
        },
        "validation_status": {
          "enum": [
            "unverified",
            "passed",
            "inconclusive"
          ],
          "title": "Validation Status",
          "type": "string"
        }
      },
      "required": [
        "execution_status",
        "side_effect_state",
        "validation_status",
        "retry_class"
      ],
      "title": "ExecutionOutcome",
      "type": "object"
    },
    "RunActionOutcome": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "$ref": "#/$defs/ExecutionOutcome"
        },
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        },
        "step_id": {
          "format": "uuid",
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "step_id",
        "outcome"
      ],
      "title": "RunActionOutcome",
      "type": "object"
    },
    "RunBudgetView": {
      "additionalProperties": false,
      "properties": {
        "charged_tokens": {
          "title": "Charged Tokens",
          "type": "integer"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "llm_attempts": {
          "title": "Llm Attempts",
          "type": "integer"
        },
        "max_llm_attempts": {
          "title": "Max Llm Attempts",
          "type": "integer"
        },
        "max_tokens": {
          "title": "Max Tokens",
          "type": "integer"
        },
        "unknown_usage_calls": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Usage Calls"
        },
        "unsettled_calls": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsettled Calls"
        }
      },
      "required": [
        "enabled",
        "max_llm_attempts",
        "max_tokens",
        "llm_attempts",
        "charged_tokens"
      ],
      "title": "RunBudgetView",
      "type": "object"
    },
    "RunCriterionView": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "validation_level": {
          "default": "V0",
          "title": "Validation Level",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source_id",
        "status"
      ],
      "title": "RunCriterionView",
      "type": "object"
    },
    "RunGoalView": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/RunCriterionView"
          },
          "title": "Criteria",
          "type": "array"
        },
        "failed": {
          "default": 0,
          "title": "Failed",
          "type": "integer"
        },
        "inconclusive": {
          "default": 0,
          "title": "Inconclusive",
          "type": "integer"
        },
        "passed": {
          "default": 0,
          "title": "Passed",
          "type": "integer"
        },
        "pending": {
          "default": 0,
          "title": "Pending",
          "type": "integer"
        },
        "required": {
          "default": 0,
          "title": "Required",
          "type": "integer"
        },
        "scope": {
          "default": "declared_run_contract",
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "default": "not_declared",
          "title": "Status",
          "type": "string"
        }
      },
      "title": "RunGoalView",
      "type": "object"
    },
    "ValidationLevel": {
      "enum": [
        "V0",
        "V1",
        "V2",
        "V3",
        "V4"
      ],
      "title": "ValidationLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_outcomes": {
      "items": {
        "$ref": "#/$defs/RunActionOutcome"
      },
      "title": "Action Outcomes",
      "type": "array"
    },
    "budget_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunBudgetView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cancel_epoch": {
      "title": "Cancel Epoch",
      "type": "integer"
    },
    "config_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Config Version"
    },
    "conversation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Conversation Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "goal": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunGoalView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "job_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Job Ids",
      "type": "array"
    },
    "persona_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Persona Version"
    },
    "plan_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Plan Ids",
      "type": "array"
    },
    "privacy_level": {
      "title": "Privacy Level",
      "type": "string"
    },
    "state_version": {
      "title": "State Version",
      "type": "integer"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "conversation_id",
    "status",
    "state_version",
    "cancel_epoch",
    "privacy_level",
    "config_version",
    "persona_version",
    "created_at",
    "updated_at"
  ],
  "title": "RunView",
  "type": "object"
}
