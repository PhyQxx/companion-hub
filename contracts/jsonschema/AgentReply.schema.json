      "type": "string"
    },
    "expressions": {
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "title": "Expressions",
      "type": "array"
    },
    "parse_status": {
      "default": "structured",
      "enum": [
        "structured",
        "fallback"
      ],
      "title": "Parse Status",
      "type": "string"
    },
    "schema_ref": {
      "const": "aria.agent-reply/1",
