      "title": "Schema Ref",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "text": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "tts_text": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Tts Text",
      "type": "string"
    }
  },
  "required": [
    "text",
    "tts_text"
  ],
  "title": "AgentReply",
  "type": "object"
