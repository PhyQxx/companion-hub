      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "expression",
            "animation",
            "sound",
            "picture"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "AgentAction",
      "type": "object"
