{
  "$defs": {
    "AssetPointer": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "format": "uuid7",
          "title": "Asset Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "media_type": {
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "media_type",
        "content_hash"
      ],
      "title": "AssetPointer",
      "type": "object"
    },
    "AudioPart": {
      "additionalProperties": false,
      "properties": {
        "asset_ref": {
          "$ref": "#/$defs/AssetPointer"
        },
        "codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Codec"
        },
        "sample_rate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 384000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        },
        "type": {
          "const": "audio",
          "default": "audio",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "asset_ref"
      ],
      "title": "AudioPart",
      "type": "object"
    },
    "DeviceCommandPart": {
      "additionalProperties": false,
      "properties": {
        "args_redacted": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Args Redacted",
          "type": "object"
        },
        "command": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
          "title": "Command",
          "type": "string"
        },
        "tool_execution_id": {
          "format": "uuid7",
          "title": "Tool Execution Id",
          "type": "string"
        },
        "type": {
          "const": "device_command",
          "default": "device_command",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "tool_execution_id",
        "command"
      ],
      "title": "DeviceCommandPart",
      "type": "object"
    },
    "FilePart": {
      "additionalProperties": false,
      "properties": {
        "asset_ref": {
          "$ref": "#/$defs/AssetPointer"
        },
        "display_name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "type": {
          "const": "file",
          "default": "file",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "asset_ref",
        "display_name"
      ],
      "title": "FilePart",
      "type": "object"
    },
    "ImagePart": {
      "additionalProperties": false,
      "properties": {
        "asset_ref": {
          "$ref": "#/$defs/AssetPointer"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "type": {
          "const": "image",
          "default": "image",
          "title": "Type",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "asset_ref"
      ],
      "title": "ImagePart",
      "type": "object"
    },
    "NotificationPart": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "category": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$",
          "title": "Category",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "const": "notification",
          "default": "notification",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "title",
        "body",
        "category"
      ],
      "title": "NotificationPart",
      "type": "object"
    },
    "Presentation": {
      "additionalProperties": false,
      "properties": {
        "emotion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emotion"
        },
        "gesture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gesture"
        },
        "intensity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intensity"
        }
      },
      "title": "Presentation",
      "type": "object"
    },
    "PrivacyLevel": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ],
      "title": "PrivacyLevel",
      "type": "string"
    },
    "SpeechPart": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "speech",
          "default": "speech",
          "title": "Type",
          "type": "string"
        },
        "voice_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice Profile"
        }
      },
      "required": [
        "text"
      ],
      "title": "SpeechPart",
      "type": "object"
    },
    "TextPart": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "default": "plain",
          "enum": [
            "plain",
            "markdown"
          ],
          "title": "Format",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "text": {
          "maxLength": 200000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextPart",
      "type": "object"
    },
    "VideoPart": {
      "additionalProperties": false,
      "properties": {
        "asset_ref": {
          "$ref": "#/$defs/AssetPointer"
        },
        "duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "type": {
          "const": "video",
          "default": "video",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "asset_ref"
      ],
      "title": "VideoPart",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter_instance_id": {
      "format": "uuid7",
      "title": "Adapter Instance Id",
      "type": "string"
    },
    "attempt": {
      "default": 1,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "deadline_at": {
      "format": "date-time",
      "title": "Deadline At",
      "type": "string"
    },
    "delivery_id": {
      "format": "uuid7",
      "title": "Delivery Id",
      "type": "string"
    },
    "endpoint_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Endpoint Id",
      "type": "string"
    },
    "generation_id": {
      "anyOf": [
        {
          "format": "uuid7",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Id"
    },
    "idempotency_key": {
      "maxLength": 255,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    },
    "intent_id": {
      "format": "uuid7",
      "title": "Intent Id",
      "type": "string"
    },
    "presentation": {
      "$ref": "#/$defs/Presentation"
    },
    "privacy_level": {
      "$ref": "#/$defs/PrivacyLevel"
    },
    "selected_content": {
      "items": {
        "discriminator": {
          "mapping": {
            "audio": "#/$defs/AudioPart",
            "device_command": "#/$defs/DeviceCommandPart",
            "file": "#/$defs/FilePart",
            "image": "#/$defs/ImagePart",
            "notification": "#/$defs/NotificationPart",
            "speech": "#/$defs/SpeechPart",
            "text": "#/$defs/TextPart",
            "video": "#/$defs/VideoPart"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TextPart"
          },
          {
            "$ref": "#/$defs/SpeechPart"
          },
          {
            "$ref": "#/$defs/AudioPart"
          },
          {
            "$ref": "#/$defs/ImagePart"
          },
          {
            "$ref": "#/$defs/VideoPart"
          },
          {
            "$ref": "#/$defs/FilePart"
          },
          {
            "$ref": "#/$defs/NotificationPart"
          },
          {
            "$ref": "#/$defs/DeviceCommandPart"
          }
        ]
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Selected Content",
      "type": "array"
    }
  },
  "required": [
    "delivery_id",
    "intent_id",
    "adapter_instance_id",
    "endpoint_id",
    "privacy_level",
    "selected_content",
    "deadline_at",
    "idempotency_key"
  ],
  "title": "DeliveryPlan",
  "type": "object"
}
