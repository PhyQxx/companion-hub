{
  "$defs": {
    "FixtureCase": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "expected": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "expected_reason": {
          "anyOf": [
            {
              "enum": [
                "operation_missing",
                "skill_arguments_invalid",
                "invalid_path_parameter"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Reason"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "operation": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "operation"
      ],
      "title": "FixtureCase",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/FixtureCase"
      },
      "maxItems": 50,
      "title": "Cases",
      "type": "array"
    },
    "data_class": {
      "const": "synthetic",
      "title": "Data Class",
      "type": "string"
    }
  },
  "required": [
    "data_class",
    "cases"
  ],
  "title": "FixtureEvaluationRequest",
  "type": "object"
}
