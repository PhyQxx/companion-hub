# Local development only. Replace every credential before a shared deployment.
POSTGRES_DB=aria
POSTGRES_USER=aria
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5433
MQTT_USERNAME=aria
MQTT_PASSWORD=change-me-mqtt
MQTT_DEVICE_ID=ld2410_bedroom
MQTT_DEVICE_USERNAME=aria_ld2410_bedroom
MQTT_DEVICE_PASSWORD=change-me-device-mqtt
ARIA_MQTT_ENABLED=false
ARIA_LOG_LEVEL=INFO
# Enable only after the process has registered consumers for every emitted topic.
ARIA_RUN_DISPATCHER=false
ARIA_CONFIG_PATH=config/hub.example.yaml
ARIA_WATCH_CONFIG=true
# Required for /api/v1/admin/*; use a long random value outside local development.
ARIA_ADMIN_TOKEN=change-me-admin-token
# XiaoAI account, speaker and gateway secrets are configured in Admin UI.
# pnkx 生活数据与待办连接器；两项同时配置时才启用。
ARIA_PNKX_BASE_URL=https://admin.pnkx.top:8/prod-api
ARIA_PNKX_TOKEN=change-me-pnkx-integration-token
ARIA_PNKX_WRITES_ENABLED=false
ARIA_TODO_SYNC_INTERVAL=300
SENSENOVA_BASE_URL=https://token.sensenova.cn
SENSENOVA_MODEL=deepseek-v4-flash
SENSENOVA_API_KEY=
# Coding Plan keys are not general runtime API credentials.
ZAI_API_KEY=
